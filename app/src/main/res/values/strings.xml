@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun VectorStudioApp() {
    val viewModel = remember { EditorViewModel() }
    val context = LocalContext.current
    val snackbarHostState = remember { SnackbarHostState() }
    val scope = rememberCoroutineScope()
    var darkMode by remember { mutableStateOf(true) }

    val selectedShape = viewModel.shapes.firstOrNull { it.id == viewModel.selectedShapeId }

    Scaffold(
        topBar = {
            Surface(
                tonalElevation = 2.dp,
                shadowElevation = 2.dp,
                color = MaterialTheme.colorScheme.surface,
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 18.dp, vertical = 10.dp),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.SpaceBetween,
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text(
                            text = "Vector Studio",
                            style = MaterialTheme.typography.headlineSmall,
                            color = MaterialTheme.colorScheme.onSurface,
                        )
                        Spacer(modifier = Modifier.width(18.dp))
                        Button(onClick = { viewModel.addShape(ShapeKind.RECTANGLE) }) {
                            Icon(Icons.Outlined.Add, contentDescription = null)
                            Spacer(modifier = Modifier.width(8.dp))
                            Text("Rect")
                        }
                        Spacer(modifier = Modifier.width(8.dp))
                        Button(onClick = { viewModel.addShape(ShapeKind.CIRCLE) }) {
                            Icon(Icons.Outlined.Add, contentDescription = null)
                            Spacer(modifier = Modifier.width(8.dp))
                            Text("Circle")
                        }
                        Spacer(modifier = Modifier.width(8.dp))
                        Button(onClick = { viewModel.addShape(ShapeKind.STAR) }) {
                            Icon(Icons.Outlined.Add, contentDescription = null)
                            Spacer(modifier = Modifier.width(8.dp))
                            Text("Star")
                        }
                    }

                    Row(verticalAlignment = Alignment.CenterVertically) {
                        IconButton(onClick = { darkMode = !darkMode }) {
                            Icon(
                                imageVector = if (darkMode) Icons.Outlined.LightMode else Icons.Outlined.DarkMode,
                                contentDescription = "Toggle theme",
                            )
                        }
                        Button(
                            onClick = {
                                val exportDir = File(context.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS), "Vector Studio")
                                exportDir.mkdirs()
                                val exportFile = File(exportDir, "vector_studio_${System.currentTimeMillis()}.svg")
                                exportFile.writeText(viewModel.exportSvg())
                                scope.launch {
                                    snackbarHostState.showSnackbar("Exported SVG: ${exportFile.absolutePath}")
                                }
                            },
                            colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary),
                        ) {
                            Icon(Icons.Outlined.FileDownload, contentDescription = null)
                            Spacer(modifier = Modifier.width(8.dp))
                            Text("Export SVG")
                        }
                    }
                }
            }
        },
        snackbarHost = { SnackbarHost(hostState = snackbarHostState) },
    ) { innerPadding ->
        Row(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .background(MaterialTheme.colorScheme.background),
        ) {
            Column(
                modifier = Modifier
                    .fillMaxHeight()
                    .width(260.dp)
                    .background(MaterialTheme.colorScheme.surfaceVariant)
                    .padding(18.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp),
            ) {
                Text("Tools", style = MaterialTheme.typography.titleMedium)
                // Palette cards
                ToolCard(title = "Shape library", subtitle = "Quick vector primitives") {
                    Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                        ShapeButton("Rectangle", ShapeKind.RECTANGLE) { viewModel.addShape(ShapeKind.RECTANGLE) }
                        ShapeButton("Circle", ShapeKind.CIRCLE) { viewModel.addShape(ShapeKind.CIRCLE) }
                        ShapeButton("Star", ShapeKind.STAR) { viewModel.addShape(ShapeKind.STAR) }
                    }
                }
                ToolCard(title = "Layers", subtitle = "Current scene order") {
                    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                        items(viewModel.shapes) { shape ->
                            val isSelected = shape.id == viewModel.selectedShapeId
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .background(
                                        if (isSelected) MaterialTheme.colorScheme.primary.copy(alpha = 0.18f)
                                        else MaterialTheme.colorScheme.surface.copy(alpha = 0.25f),
                                        RoundedCornerShape(10.dp),
                                    )
                                    .padding(horizontal = 10.dp, vertical = 8.dp)
                                    .clickable { viewModel.selectShape(shape.id) },
                                horizontalArrangement = Arrangement.SpaceBetween,
                                verticalAlignment = Alignment.CenterVertically,
                            ) {
                                Text(
                                    text = shape.kind.name.lowercase().replaceFirstChar { it.titlecase() },
                                    color = MaterialTheme.colorScheme.onSurface,
                                )
                                Text(
                                    text = "${shape.width.toInt()}×${shape.height.toInt()}",
                                    fontSize = 11.sp,
                                    color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.7f),
                                )
                            }
                        }
                    }
                }
            }

            Box(
                modifier = Modifier
                    .weight(1f)
                    .padding(20.dp),
            ) {
                CanvasBoard(
                    shapes = viewModel.shapes,
                    selectedShapeId = viewModel.selectedShapeId,
                    onShapeSelected = { viewModel.selectShape(it) },
                    onShapeMoved = { id, dragAmount ->
                        val shape = viewModel.shapes.firstOrNull { it.id == id } ?: return@CanvasBoard
                        shape.x = (shape.x + dragAmount.x).coerceAtLeast(10f)
                        shape.y = (shape.y + dragAmount.y).coerceAtLeast(10f)
                    },
                    onShapeResized = { id, dragAmount ->
                        val shape = viewModel.shapes.firstOrNull { it.id == id } ?: return@CanvasBoard
                        shape.width = (shape.width + dragAmount.x).coerceAtLeast(60f)
                        shape.height = (shape.height + dragAmount.y).coerceAtLeast(60f)
                    },
                )
            }

            Column(
                modifier = Modifier
                    .fillMaxHeight()
                    .width(290.dp)
                    .background(MaterialTheme.colorScheme.surface)
                    .padding(18.dp),
                verticalArrangement = Arrangement.spacedBy(18.dp),
            ) {
                Text("Inspector", style = MaterialTheme.typography.titleMedium)
                if (selectedShape == null) {
                    Text("Select a shape to edit it.")
                } else {
                    Text(
                        text = selectedShape.kind.name.lowercase().replaceFirstChar { it.titlecase() },
                        style = MaterialTheme.typography.titleSmall,
                    )
                    Slider(
                        value = selectedShape.strokeWidth,
                        onValueChange = { viewModel.applyStrokeWidth(it) },
                        valueRange = 1f..18f,
                    )
                    Slider(
                        value = selectedShape.rotation,
                        onValueChange = { viewModel.applyRotation(it) },
                        valueRange = 0f..360f,
                    )

                    Text("Fill")
                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        ColorOption(Color(0xFF7C9BFF.toInt())) { viewModel.applyFill(it) }
                        ColorOption(Color(0xFF7EE7C7.toInt())) { viewModel.applyFill(it) }
                        ColorOption(Color(0xFFF9A8D4.toInt())) { viewModel.applyFill(it) }
                        ColorOption(Color(0xFFFACF5A.toInt())) { viewModel.applyFill(it) }
                    }

                    Text("Stroke")
                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        ColorOption(Color(0xFF0F172A.toInt())) { viewModel.applyStroke(it) }
                        ColorOption(Color(0xFF1F2937.toInt())) { viewModel.applyStroke(it) }
                        ColorOption(Color(0xFF374151.toInt())) { viewModel.applyStroke(it) }
                        ColorOption(Color(0xFFEF4444.toInt())) { viewModel.applyStroke(it) }
                    }

                    OutlinedButton(
                        onClick = { viewModel.deleteSelected() },
                        modifier = Modifier.fillMaxWidth(),
                    ) {
                        Icon(Icons.Outlined.Delete, contentDescription = null)
                        Spacer(modifier = Modifier.width(8.dp))
                        Text("Delete selected")
                    }
                }
            }
        }
    }
}

@Composable
private fun ToolCard(
    title: String,
    subtitle: String,
    content: @Composable () -> Unit,
) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
        border = BorderStroke(1.dp, MaterialTheme.colorScheme.outline.copy(alpha = 0.3f)),
    ) {
        Column(modifier = Modifier.padding(12.dp)) {
            Text(title, style = MaterialTheme.typography.titleSmall)
            Text(subtitle, fontSize = 11.sp, color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.7f))
            Spacer(modifier = Modifier.height(10.dp))
            content()
        }
    }
}

@Composable
private fun ShapeButton(
    label: String,
    shapeKind: ShapeKind,
    onClick: () -> Unit,
) {
    OutlinedButton(
        onClick = onClick,
        modifier = Modifier.fillMaxWidth(),
    ) {
        Icon(Icons.Outlined.Palette, contentDescription = null)
        Spacer(modifier = Modifier.width(8.dp))
        Text(label)
    }
}

@Composable
private fun ColorOption(color: Color, onSelect: (Color) -> Unit) {
    Box(
        modifier = Modifier
            .size(28.dp)
            .background(color, RoundedCornerShape(8.dp))
            .border(2.dp, MaterialTheme.colorScheme.onSurface.copy(alpha = 0.3f), RoundedCornerShape(8.dp))
            .clickable { onSelect(color) },
    )
}

@Composable
private fun CanvasBoard(
    shapes: List<EditableShape>,
    selectedShapeId: Long?,
    onShapeSelected: (Long) -> Unit,
    onShapeMoved: (Long, Offset) -> Unit,
    onShapeResized: (Long, Offset) -> Unit,
) {
    val density = LocalDensity.current
    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(MaterialTheme.colorScheme.surfaceVariant, RoundedCornerShape(22.dp))
            .border(2.dp, MaterialTheme.colorScheme.outline.copy(alpha = 0.7f), RoundedCornerShape(22.dp)),
    ) {
        Canvas(modifier = Modifier.fillMaxSize()) {
            val canvasWidth = size.width
            val canvasHeight = size.height
            drawRect(
                color = MaterialTheme.colorScheme.surface.copy(alpha = 0.4f),
                size = Size(canvasWidth, canvasHeight),
            )

            shapes.forEach { shape ->
                val originX = shape.x
                val originY = shape.y
                val centerX = originX + shape.width / 2f
                val centerY = originY + shape.height / 2f

                if (shape.kind == ShapeKind.RECTANGLE) {
                    rotate(degrees = shape.rotation, pivot = Offset(centerX, centerY)) {
                        drawRoundRect(
                            color = shape.fill,
                            topLeft = Offset(originX, originY),
                            size = Size(shape.width, shape.height),
                            cornerRadius = androidx.compose.ui.geometry.CornerRadius(28f),
                            style = androidx.compose.ui.graphics.drawscope.Stroke(shape.strokeWidth),
                        )
                        drawRoundRect(
                            color = shape.fill.copy(alpha = 0.2f),
                            topLeft = Offset(originX, originY),
                            size = Size(shape.width, shape.height),
                            cornerRadius = androidx.compose.ui.geometry.CornerRadius(28f),
                        )
                    }
                }
                if (shape.kind == ShapeKind.CIRCLE) {
                    drawOval(
                        color = shape.fill.copy(alpha = 0.9f),
                        topLeft = Offset(originX, originY),
                        size = Size(shape.width, shape.height),
                        style = Stroke(width = shape.strokeWidth),
                    )
                }
                if (shape.kind == ShapeKind.STAR) {
                    val path = buildStarPath(
                        cx = centerX,
                        cy = centerY,
                        outerRadius = shape.width / 2f,
                        innerRadius = shape.width / 4f,
                    )
                    drawPath(
                        color = shape.fill,
                        path = path,
                        alpha = 1f,
                    )
                    drawPath(
                        path = path,
                        color = shape.stroke,
                        style = Stroke(width = shape.strokeWidth),
                    )
                }

                if (shape.id == selectedShapeId) {
                    val handleSize = 10.dp.toPx()
                    val box = Offset(originX - 8f, originY - 8f)
                    drawRoundRect(
                        color = MaterialTheme.colorScheme.primary,
                        topLeft = box,
                        size = Size(shape.width + 16f, shape.height + 16f),
                        cornerRadius = androidx.compose.ui.geometry.CornerRadius(10f),
                        style = Stroke(width = 2f),
                    )
                    drawRect(
                        color = MaterialTheme.colorScheme.primary,
                        topLeft = Offset(originX + shape.width - handleSize / 2, originY + shape.height - handleSize / 2),
                        size = Size(handleSize, handleSize),
                    )
                }
            }
        }

        shapes.forEach { shape ->
            val sizeDp = with(density) { (shape.width to Int).toDp() }
            val heightDp = with(density) { (shape.height to Int).toDp() }
            Box(
                modifier = Modifier
                    .offset(x = with(density) { shape.x.toInt().toDp() }, y = with(density) { shape.y.toInt().toDp() })
                    .size(width = with(density) { shape.width.toDp() }, height = with(density) { shape.height.toDp() })
                    .pointerInput(shape.id) {
                        androidx.compose.foundation.gestures.detectDragGestures(
                            onDragStart = { onShapeSelected(shape.id) },
                            onDrag = { _, dragAmount ->
                                if (dragAmount.x != 0f || dragAmount.y != 0f) {
                                    onShapeMoved(shape.id, dragAmount)
                                }
                            },
                            onDragEnd = { },
                        )
                    }
                    .clickable { onShapeSelected(shape.id) },
            ) {
                if (shape.id == selectedShapeId) {
                    Box(
                        modifier = Modifier
                            .align(Alignment.BottomEnd)
                            .size(18.dp)
                            .background(MaterialTheme.colorScheme.primary, RoundedCornerShape(8.dp))
                            .pointerInput(shape.id) {
                                androidx.compose.foundation.gestures.detectDragGestures(
                                    onDrag = { _, dragAmount -> onShapeResized(shape.id, dragAmount) },
                                )
                            },
                    )
                }
            }
        }
    }
}
